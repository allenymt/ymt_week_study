<?xml version="1.0" encoding="utf-8"?>
<!--
  本周页。上半部分是 7 天 × 6 项的表格（对应纸质表上半张），
  下半部分是汇总卡片与一句话总结（对应纸质表下半张）。
  内容在竖屏下会超出一屏，所以整页套一层 ScrollView；
  表格用固定行高而非 weight 撑满，避免嵌在滚动容器里被压扁。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/prevWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上一周" />

            <TextView
                android:id="@+id/weekTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/nextWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下一周" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="孩子申报模式"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/childModeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 列标题行。内容由 WeekFragment 按 ItemColumns.ROW_ITEMS 生成，
             保证列顺序与数据行一致，不会各自漂移。 -->
        <LinearLayout
            android:id="@+id/headerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp" />

        <!-- 表格行。固定 7 行，由 WeekRowAdapter 渲染；不滚动，随整页一起滚。 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/weekRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- 汇总卡片：保底 / 无投诉 / 每日加分 / 考试奖励 / 投诉扣分 / 总赚取 / 已使用 / 结余 -->
        <include
            android:id="@+id/summaryCard"
            layout="@layout/card_week_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="本周一句话总结"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="做得好的"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/noteGood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="这周哪些地方做得好" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="下周改进"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/noteImprove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="下周想在哪些地方改进" />

        <!-- 仅在文字有改动时才写库，避免每敲一下都触发一次写入。 -->
        <Button
            android:id="@+id/saveNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="保存总结" />
    </LinearLayout>
</ScrollView>
